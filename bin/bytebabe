#!/bin/bash

# Resolve o diretório base seguindo symlinks (ex: /usr/local/bin/bytebabe)
SOURCE_PATH="${BASH_SOURCE[0]:-$0}"
while [ -L "$SOURCE_PATH" ]; do
    SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
    SOURCE_PATH="$(readlink "$SOURCE_PATH")"
    [[ "$SOURCE_PATH" != /* ]] && SOURCE_PATH="${SOURCE_DIR}/${SOURCE_PATH}"
done
BASE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")/.." && pwd)"

# Carrega as dependências
source "$BASE_DIR/lib/core/colors.sh"
source "$BASE_DIR/lib/core/helpers.sh"
source "$BASE_DIR/lib/core/alias_manager.sh"

# Expande aliases se necessário
if [ $# -gt 0 ]; then
    expanded=$(expand_alias "$1")
    if [ ! -z "$expanded" ]; then
        shift
        set -- $expanded "$@"
    fi
fi

VERSION="1.5.0"

# Show version information
show_version() {
    echo -e "${CYBER_PINK}╔════════════════════════════════════════════════╗       "
    echo -e "║${CYBER_CYAN}       ▓▓▓ BYTEBABE CLI v${VERSION} ▓▓▓ ${CYBER_PINK}"
    echo -e "║${CYBER_GREEN}   ░▓█►  System: $(uname -srm)${CYBER_PINK}               "
    echo -e "║${CYBER_GREEN}   ░▓█►  Shell: $(basename $SHELL)${CYBER_PINK}           "
    echo -e "║${CYBER_GREEN}   ░▓█►  Uptime: $(uptime -p)${CYBER_PINK}                "
    echo -e "╚════════════════════════════════════════════════╝${RESET}"
}

# Show help information
show_help() {
    echo -e "${CYBER_YELLOW}⚡ ${CYBER_BLUE}CORE COMMANDS:${RESET}"
    echo -e "  ${CYBER_GREEN}hello${RESET}         Receba uma mensagem cyberpunk aleatória"
    echo -e "  ${CYBER_GREEN}init${RESET}          Inicializa o ambiente de desenvolvimento"
    echo -e "  ${CYBER_GREEN}edit${RESET}, ${CYBER_GREEN}byteedit${RESET}  Edita arquivos de configuração"
    echo -e "  ${CYBER_GREEN}alias${RESET}         Gerencia aliases (add/list/search/remove/template...)"
    echo -e ""
    echo -e "${CYBER_YELLOW}⚡ ${CYBER_BLUE}DEVELOPMENT STACK:${RESET}"
    echo -e "  ${CYBER_GREEN}frontend${RESET}      Ferramentas de frontend"
    echo -e "    ${CYBER_GRAY}└─ setup${RESET}     Configura o ambiente frontend"
    echo -e "  ${CYBER_GREEN}backend${RESET}       Ferramentas de backend"
    echo -e "    ${CYBER_GRAY}└─ setup${RESET}     Configura o ambiente backend"
    echo -e "    ${CYBER_GRAY}└─ install${RESET}   Instala uma tecnologia específica"
    echo -e "    ${CYBER_GRAY}└─ list${RESET}      Lista tecnologias suportadas"
    echo -e "  ${CYBER_GREEN}spring${RESET}        Ferramentas Spring Boot"
    echo -e "    ${CYBER_GRAY}└─ new${RESET}       Cria um novo projeto Spring Boot"
    echo -e "    ${CYBER_GRAY}└─ generate${RESET}  Gera componentes Spring"
    echo -e ""
    echo -e "${CYBER_YELLOW}⚡ ${CYBER_BLUE}DEVELOPMENT TOOLS:${RESET}"
    echo -e "  ${CYBER_GREEN}ide${RESET}           Gerenciamento de IDEs"
    echo -e "    ${CYBER_GRAY}└─ vscode${RESET}    Configuração do VS Code"
    echo -e "    ${CYBER_GRAY}└─ intellij${RESET}  Configuração do IntelliJ IDEA"
    echo -e "    ${CYBER_GRAY}└─ install/run/status/list${RESET}"
    echo -e "  ${CYBER_GREEN}devtools${RESET}      Ferramentas de desenvolvimento"
    echo -e "    ${CYBER_GRAY}└─ terminal${RESET}  Zsh/OhMyZsh/Spaceship/Atuin (alias: t)"
    echo -e "    ${CYBER_GRAY}└─ database${RESET}  TablePlus/DBeaver/Compass/pgAdmin (alias: d)"
    echo -e "    ${CYBER_GRAY}└─ browser${RESET}   Chrome/Firefox/Brave/Edge/Vivaldi (alias: b)"
    echo -e "    ${CYBER_GRAY}└─ api${RESET}       curl/httpie/jq/yq/grpcurl/websocat (alias: a)"
    echo -e ""
    echo -e "${CYBER_YELLOW}⚡ ${CYBER_BLUE}VERSION CONTROL:${RESET}"
    echo -e "  ${CYBER_GREEN}git${RESET}           Operações avançadas de Git"
    echo -e "  ${CYBER_GREEN}gh${RESET}, ${CYBER_GREEN}github${RESET}    Ferramentas e atalhos do GitHub"
    echo -e ""
    echo -e "${CYBER_YELLOW}⚡ ${CYBER_BLUE}INFRASTRUCTURE:${RESET}"
    echo -e "  ${CYBER_GREEN}servers${RESET}       Gerenciamento de servidores"
    echo -e "    ${CYBER_GRAY}└─ up/down${RESET}   Inicia/para servidores"
    echo -e "    ${CYBER_GRAY}└─ status${RESET}    Verifica o status"
    echo -e "    ${CYBER_GRAY}└─ setup${RESET}     Gera configuração Docker Compose"
    echo -e "  ${CYBER_GREEN}docker${RESET}        Operações Docker (containers, imagens, volumes, compose)"
    echo -e "  ${CYBER_GREEN}db${RESET}            Operações de banco de dados"
    echo -e "    ${CYBER_GRAY}└─ setup/install/start/stop/status${RESET}"
    echo -e "  ${CYBER_GREEN}datavision${RESET}, ${CYBER_GREEN}dv${RESET}  Gerenciador de bancos (tipo DBeaver)"
    echo -e "    ${CYBER_GRAY}└─ connect/add/list/remove${RESET}"
    echo -e ""
    echo -e "${CYBER_YELLOW}⚡ ${CYBER_BLUE}API TOOLS:${RESET}"
    echo -e "  ${CYBER_GREEN}flux${RESET}          Terminal API Studio 🌊"
    echo -e "  ${CYBER_GREEN}prime${RESET}, ${CYBER_GREEN}pm${RESET}     Ferramentas Prime API"
    echo -e ""
    echo -e "${CYBER_YELLOW}⚡ ${CYBER_BLUE}ALIASES GLOBAIS:${RESET}"
    echo -e "  ${CYBER_GREEN}dev${RESET}  → ${CYBER_CYAN}devtools${RESET}          ${CYBER_GREEN}dt${RESET}  → ${CYBER_CYAN}devtools terminal${RESET}"
    echo -e "  ${CYBER_GREEN}term${RESET} → ${CYBER_CYAN}devtools terminal${RESET}  ${CYBER_GREEN}atuin${RESET} → ${CYBER_CYAN}devtools terminal atuin${RESET}"
    echo -e ""
    echo -e "${CYBER_YELLOW}⚡ ${CYBER_BLUE}SYSTEM:${RESET}"
    echo -e "  ${CYBER_GREEN}--version${RESET}, ${CYBER_GREEN}-v${RESET}  Mostra a versão da CLI"
    echo -e "  ${CYBER_GREEN}help${RESET}, ${CYBER_GREEN}--help${RESET}, ${CYBER_GREEN}-h${RESET}  Mostra esta ajuda"
    echo -e ""
    echo -e "${CYBER_PURPLE}╰┈➤ ${CYBER_GRAY}Para ajuda detalhada, use: ${CYBER_CYAN}bytebabe <comando> --help${RESET}"
}

run_command() {
    local module="$1"
    local entrypoint="$2"
    shift 2

    if [[ ! -f "$module" ]]; then
        echo "Módulo não encontrado: $module" >&2
        return 1
    fi

    source "$module" || return $?

    if ! declare -F "$entrypoint" >/dev/null 2>&1; then
        echo "Entrypoint '$entrypoint' não encontrado em $module" >&2
        return 1
    fi

    "$entrypoint" "$@"
}

show_cyberpunk_header

# Process commands
case "$1" in
    alias)
        shift
        main "$@"
        ;;
    hello)
        run_command "${BASE_DIR}/commands/hello/main.sh" main "${@:2}"
        ;;
    init)
        run_command "${BASE_DIR}/commands/init/main.sh" main "${@:2}"
        ;;
    git)
        run_command "${BASE_DIR}/commands/git/main.sh" main "${@:2}"
        ;;
    frontend)
        run_command "${BASE_DIR}/commands/frontend/main.sh" main "${@:2}"
        ;;
    backend)
        run_command "${BASE_DIR}/commands/backend/main.sh" main "${@:2}"
        ;;
    spring)
        run_command "${BASE_DIR}/commands/backend/spring/main.sh" main "${@:2}"
        ;;
    servers)
        run_command "${BASE_DIR}/commands/servers/main.sh" main "${@:2}"
        ;;
    db)
        run_command "${BASE_DIR}/commands/db/main.sh" main "${@:2}"
        ;;
    datavision|dv)
        run_command "${BASE_DIR}/lib/database/datavision.sh" datavision_main "${@:2}"
        ;;
    edit|byteedit)
        run_command "${BASE_DIR}/commands/byteedit/main.sh" main "${@:2}"
        ;;
    ide)
        run_command "${BASE_DIR}/commands/ide/main.sh" main "${@:2}"
        ;;
    devtools)
        run_command "${BASE_DIR}/commands/devtools/main.sh" main "${@:2}"
        ;;
    docker)
        run_command "${BASE_DIR}/commands/docker/main.sh" main "${@:2}"
        ;;
    prime|pm)
        run_command "${BASE_DIR}/commands/prime/main.sh" main "${@:2}"
        ;;
    gh|github)
        run_command "${BASE_DIR}/commands/gh/main.sh" main "${@:2}"
        ;;
    flux)
        run_command "${BASE_DIR}/commands/flux/main.sh" main "${@:2}"
        ;;
    --version|-v)
        show_version
        exit 0
        ;;
    help|h|--help|-h)
        show_help
        exit 0
        ;;
    *)
        show_help
        ;;
esac

exit $?
